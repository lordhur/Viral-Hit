{
  "name": "viral-hit",
  "version": "0.1.0",
  "description": "Local-first AI agent for viral clips and narrated video recaps, with browser, desktop, CLI and MCP interfaces.",
  "main": "./out/main/index.js",
  "author": "Viral Hit contributors",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/lordhur/Viral-Hit",
  "repository": {
    "type": "git",
    "url": "https://github.com/lordhur/Viral-Hit.git"
  },
  "scripts": {
    "dev": "pnpm exec install-electron && electron-vite dev",
    "setup:desktop": "install-electron",
    "dev:web": "vite --config vite.renderer.config.ts --host 0.0.0.0",
    "dev:agent": "tsx src/server/index.ts",
    "setup:media": "node scripts/setup-media.mjs",
    "start:web": "tsx src/server/index.ts",
    "build:web": "vite build --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "quality:eval": "tsx tools/quality-eval.ts",
    "quality:eval:asr": "tsx tools/asr-model-benchmark.ts",
    "quality:eval:vision": "tsx tools/vision-model-benchmark.ts",
    "mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts",
    "start": "pnpm build:web && tsx src/server/index.ts",
    "start:desktop": "pnpm exec install-electron && electron-vite preview",
    "pack:dir": "pnpm exec install-electron && electron-vite build && electron-builder --dir",
    "dist": "pnpm exec install-electron && electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unbzip2-stream": "^1.4.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "sherpa-onnx-node": "^1.13.3",
    "tailwindcss": "^4.3.2",
    "tar": "^7.5.22",
    "unbzip2-stream": "^1.4.3",
    "zustand": "^5.0.14"
  }
}
