# Détection de clips : gratuit et local par défaut, sans clé API.
# Option avancée : ollama (local) ; les fournisseurs cloud historiques restent compatibles.
VIRALHIT_LLM_PROVIDER=builtin
VIRALHIT_LLM_BASE_URL=
VIRALHIT_LLM_MODEL=
VIRALHIT_LLM_API_KEY=
# Pour Ollama : provider=ollama, base_url=http://127.0.0.1:11434/v1, model=qwen3:4b

# Optional request timeout in seconds (1–1800)
VIRALHIT_LLM_TIMEOUT_SECONDS=240

# Anciens récaps cloud facultatifs — inutiles pour les clips et le mode gratuit.
# Le récap gratuit exige Ollama + IndexTTS locaux et l’option skip-asr.
MIMO_API_KEY=
# MIMO_VIDEO_API_KEY=
# MIMO_ASR_API_KEY=
# MIMO_TTS_API_KEY=
# FISH_API_KEY=
# TTS_PROVIDER=mimo-tts

# Local data (uploads, resumable runs, caches). Defaults to the OS user-data directory.
# VIRALHIT_DATA_DIR=/absolute/path/to/viral-hit-data

# Easy local access: UI and API share this origin. The safe default is loopback only.
# For an Arena/container preview, explicitly set VIRALHIT_HOST=0.0.0.0.
VIRALHIT_HOST=127.0.0.1
VIRALHIT_PORT=8787
# VIRALHIT_UPLOAD_LIMIT_GB=50

# Optional validated media/Python installations. Run `corepack pnpm setup:media`
# for an ignored local FFmpeg cache instead of setting these manually.
# VIRALHIT_FFMPEG=/absolute/path/to/ffmpeg
# VIRALHIT_FFPROBE=/absolute/path/to/ffprobe
# VIRALHIT_PYTHON=python3

# Legacy variables remain accepted by the clipping engine. New setups should use VIRALHIT_*.
# HOTCLIP_LLM_BASE_URL=
# HOTCLIP_LLM_MODEL=
# HOTCLIP_LLM_API_KEY=
